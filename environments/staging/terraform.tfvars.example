aws_region   = "ap-southeast-1"
project_name = "tf2-finops"
environment  = "staging"

tags = {
  Environment = "staging"
  Project     = "tf2-finops"
  ManagedBy   = "Terraform"
}

# AI Engine Lambda Container Images (must be digest-pinned to satisfy validation)
request_image_uri = "123456789012.dkr.ecr.ap-southeast-1.amazonaws.com/tf2-finops-staging-ai-request@sha256:d801127a92c011e3b664d4b1a4574a625db1db8b2bc01dfb00eeaa1c296711c2"

# S3 Cross-Region Replication region
replica_region = "ap-southeast-2"

# CloudFront Custom Domain Configuration (ACM certificate must be in us-east-1)
cloudfront_acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/12345678-1234-1234-1234-123456789012"
cloudfront_aliases             = ["dashboard.staging.example.com"]

# CloudFront Geo-restrictions
dashboard_geo_restriction_type      = "blacklist"
dashboard_geo_restriction_locations = ["CU", "IR", "KP", "SY"]

# ACM Certificate ARN for the internal ALB HTTPS listener
alb_certificate_arn = "arn:aws:acm:ap-southeast-1:123456789012:certificate/12345678-1234-1234-1234-123456789012"

# Route 53 parameters (Optional)
private_hosted_zone_id = ""
private_dns_name       = ""
sigv4_service_name     = "ai-engine"

# CUR and CE Ingestion parameters
cur_source_bucket          = "company-cdo-123456789012-telemetry"
cur_source_prefix          = "cdo-01/"
cur_delay_threshold_hours  = 36
ce_lookback_window_days    = 30
traffic_metric_identifiers  = ["my-alb-identifier"]
synthetic_fallback_enabled = true


