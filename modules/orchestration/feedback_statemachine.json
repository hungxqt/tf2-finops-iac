{
  "Comment": "TF2 FinOps Watch asynchronous human feedback workflow",
  "StartAt": "ValidateHumanFeedback",
  "States": {
    "ValidateHumanFeedback": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.human_feedback.anomaly_id",
              "IsPresent": true
            },
            {
              "Variable": "$.human_feedback.reviewer_id",
              "IsPresent": true
            },
            {
              "Variable": "$.human_feedback.reason",
              "IsPresent": true
            },
            {
              "Variable": "$.human_feedback.reviewed_at",
              "IsPresent": true
            },
            {
              "Or": [
                {
                  "Variable": "$.human_feedback.verdict",
                  "StringEquals": "TRUE_POSITIVE"
                },
                {
                  "Variable": "$.human_feedback.verdict",
                  "StringEquals": "FALSE_POSITIVE"
                },
                {
                  "Variable": "$.human_feedback.verdict",
                  "StringEquals": "BENIGN_EVENT"
                }
              ]
            }
          ],
          "Next": "SubmitHumanFeedback"
        }
      ],
      "Default": "SetInvalidHumanFeedbackError"
    },
    "SubmitHumanFeedback": {
      "Type": "Task",
      "Comment": "Submit contract-valid SRE/Engineer review feedback to AI Engine via POST /v1/feedback for active-learning calibration.",
      "Resource": "${vpc_alb_caller_lambda_arn}",
      "Parameters": {
        "path": "/v1/feedback",
        "method": "POST",
        "tenant_id.$": "$.tenant_id",
        "correlation_id.$": "$.correlation_id",
        "idempotency_key.$": "States.Format('{}:{}:{}:feedback', $.tenant_id, $.human_feedback.anomaly_id, $.human_feedback.reviewer_id)",
        "ai_contract_version.$": "$.ai_contract_version",
        "dry_run_mode": true,
        "body": {
          "anomaly_id.$": "$.human_feedback.anomaly_id",
          "reviewer_id.$": "$.human_feedback.reviewer_id",
          "verdict.$": "$.human_feedback.verdict",
          "reason.$": "$.human_feedback.reason",
          "reviewed_at.$": "$.human_feedback.reviewed_at"
        }
      },
      "ResultPath": "$.feedback_result",
      "Next": "WriteHumanFeedbackAudit",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.feedback_error",
          "Next": "WriteHumanFeedbackFailureAudit"
        }
      ]
    },
    "WriteHumanFeedbackAudit": {
      "Type": "Task",
      "Resource": "${audit_writer_lambda_arn}",
      "Parameters": {
        "run_id.$": "$.run_id",
        "correlation_id.$": "$.correlation_id",
        "account_id.$": "$.account_id",
        "cost_period.$": "$.cost_period",
        "execution_date.$": "$.execution_date",
        "tenant_id.$": "$.tenant_id",
        "action": "human-feedback-submitted",
        "human_feedback.$": "$.human_feedback",
        "feedback_result.$": "$.feedback_result"
      },
      "ResultPath": "$.feedback_audit",
      "Next": "FeedbackCompleted",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FeedbackFailed"
        }
      ]
    },
    "WriteHumanFeedbackFailureAudit": {
      "Type": "Task",
      "Resource": "${audit_writer_lambda_arn}",
      "Parameters": {
        "run_id.$": "$.run_id",
        "correlation_id.$": "$.correlation_id",
        "account_id.$": "$.account_id",
        "cost_period.$": "$.cost_period",
        "execution_date.$": "$.execution_date",
        "tenant_id.$": "$.tenant_id",
        "action": "human-feedback-delivery-failed",
        "human_feedback.$": "$.human_feedback",
        "error.$": "$.feedback_error"
      },
      "ResultPath": "$.feedback_failure_audit",
      "Next": "SetHumanFeedbackDeliveryError",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FeedbackFailed"
        }
      ]
    },
    "SetInvalidHumanFeedbackError": {
      "Type": "Pass",
      "Result": {
        "Error": "InvalidHumanFeedback",
        "Cause": "human_feedback must satisfy telemetry-contract section 15 before calling /v1/feedback."
      },
      "ResultPath": "$.error",
      "Next": "WriteInvalidHumanFeedbackAudit"
    },
    "WriteInvalidHumanFeedbackAudit": {
      "Type": "Task",
      "Resource": "${audit_writer_lambda_arn}",
      "Parameters": {
        "run_id.$": "$.run_id",
        "correlation_id.$": "$.correlation_id",
        "account_id.$": "$.account_id",
        "cost_period.$": "$.cost_period",
        "execution_date.$": "$.execution_date",
        "tenant_id.$": "$.tenant_id",
        "action": "human-feedback-invalid",
        "human_feedback.$": "$.human_feedback",
        "error.$": "$.error"
      },
      "ResultPath": "$.invalid_feedback_audit",
      "Next": "FeedbackFailed"
    },
    "SetHumanFeedbackDeliveryError": {
      "Type": "Pass",
      "Result": {
        "Error": "HumanFeedbackDeliveryFailed",
        "Cause": "Failed to deliver human feedback to AI Engine after retries; audit evidence was written."
      },
      "ResultPath": "$.error",
      "Next": "FeedbackFailed"
    },
    "FeedbackCompleted": {
      "Type": "Succeed"
    },
    "FeedbackFailed": {
      "Type": "Fail",
      "Error": "FinOpsHumanFeedbackWorkflowFailed",
      "Cause": "Human feedback workflow failed validation or delivery."
    }
  }
}
