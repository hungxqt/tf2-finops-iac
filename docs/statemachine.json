          "correlation_id.$": "$.correlation_id",
          "tenant_id.$": "$.tenant_id",
          "status": "APPLIED",
          "action.$": "$.ai.recommended_containment_mode",
          "timestamp.$": "$.execution_date"
        }
      },
      "ResultPath": "$.sqs_applied_result",
      "Next": "MarkRunComplete"
    },
    "WriteDeniedAudit": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:123456789012:function:tf2-finops-sandbox-audit_writer",
      "ResultPath": "$.denied_audit",
      "Next": "SendDeniedStatusMessage",
      "Retry": [
