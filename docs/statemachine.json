    },
    "ReportVerifyResult": {
      "Type": "Task",
      "Comment": "Step Functions invokes VpcAlbCallerLambda; helper sends signed HTTPS to internal ALB; ALB invokes AI Engine Request Lambda live alias.",
      "Resource": "arn:aws:lambda:ap-southeast-1:123456789012:function:tf2-finops-sandbox-vpc_alb_caller",
      "Parameters": {
        "path": "/v1/verify",
        "method": "POST",
        "tenant_id.$": "$.tenant_id",
        "correlation_id.$": "$.correlation_id",
        "idempotency_key.$": "$.correlation_id",
        "ai_contract_version.$": "$.ai_contract_version",
        "body": {
          "correlation_id.$": "$.correlation_id",
          "idempotency_key.$": "$.correlation_id",
          "dry_run_mode.$": "$.force_dry_run",
          "action_executed": {
            "action.$": "$.ai.recommended_containment_mode",
            "target.$": "$.ai_detect_response.anomalies_list[0].resource_id",
            "status": "COMPLETED"
          },
          "post_telemetry_window": {
            "data_source_type": "RAW_JSON",
            "telemetry_delay_event.$": "$.normalized.details.delayed_cur",
            "aws_cur_line_items.$": "$.normalized.details.aws_cur_line_items"
          }
        }
      },
      "ResultPath": "$.verify_result",
      "Next": "WritePostActionAudit",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailClosed"
        }
      ]
    },
    "WritePostActionAudit": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:123456789012:function:tf2-finops-sandbox-audit_writer",
      "ResultPath": "$.post_audit",
      "Next": "SendAppliedStatusMessage",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
