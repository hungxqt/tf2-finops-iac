{
  "Comment": "TF2 FinOps Watch CDO daily workflow",
  "StartAt": "PrepareRunContext",
  "States": {
    "PrepareRunContext": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:123456789012:function:tf2-finops-sandbox-state",
      "Parameters": {
        "operation": "prepare",
        "input.$": "$",
        "ai_contract_version": "v1",
        "ai_retry_max": "6",
        "ai_poll_interval": "10"
      },
      "ResultPath": "$",
      "Next": "LoadAccountPolicy",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkRunFailed"
        }
      ]
    },
    "LoadAccountPolicy": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:getItem",
      "Parameters": {
        "TableName": "tf2-finops-sandbox-account-policy",
        "Key": {
          "account_id": {
            "S.$": "$.account_id"
          }
        }
      },
      "ResultSelector": {
        "account_id.$": "$.Item.account_id.S",
        "environment.$": "$.Item.environment.S"
      },
      "ResultPath": "$.account_policy",
      "Next": "OverwriteEnvironment",
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDb.SdkClientException",
            "DynamoDb.AmazonDynamoDBException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkRunFailed"
        }
      ]
    },
    "OverwriteEnvironment": {
      "Type": "Pass",
      "InputPath": "$.account_policy.environment",
      "ResultPath": "$.environment",
      "Next": "CheckRunState"
    },
    "CheckRunState": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:123456789012:function:tf2-finops-sandbox-state",
      "Parameters": {
        "operation": "check",
        "run_id.$": "$.run_id",
        "correlation_id.$": "$.correlation_id",
        "account_id.$": "$.account_id",
        "cost_period.$": "$.cost_period",
        "execution_date.$": "$.execution_date"
      },
      "ResultPath": "$.state",
      "Next": "DuplicateRun",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkRunFailed"
        }
      ]
    },
    "DuplicateRun": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.state.status",
          "StringEquals": "COMPLETED",
          "Next": "DuplicateIgnored"
        },
        {
          "Variable": "$.state.status",
          "StringEquals": "IN_PROGRESS",
          "Next": "DuplicateIgnored"
        }
      ],
      "Default": "CheckAdHocQuotaDecision"
    },
    "CheckAdHocQuotaDecision": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.is_ad_hoc",
          "BooleanEquals": true,
          "Next": "CheckAdHocQuota"
        }
      ],
      "Default": "CheckErrorBudgetLock"
    },
    "CheckAdHocQuota": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:123456789012:function:tf2-finops-sandbox-state",
      "Parameters": {
        "operation": "check_quota",
        "run_id.$": "$.run_id",
        "correlation_id.$": "$.correlation_id",
        "account_id.$": "$.account_id",
        "cost_period.$": "$.cost_period",
        "execution_date.$": "$.execution_date",
        "is_ad_hoc.$": "$.is_ad_hoc",
        "tenant_id.$": "$.tenant_id"
      },
      "ResultPath": "$.quota_check",
      "Next": "EvaluateAdHocQuota",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkRunFailed"
        }
      ]
    },
    "EvaluateAdHocQuota": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.quota_check.status",
          "StringEquals": "QUOTA_EXCEEDED",
          "Next": "SetQuotaExceededError"
        }
      ],
      "Default": "CheckErrorBudgetLock"
    },
    "SetQuotaExceededError": {
      "Type": "Pass",
      "Result": {
        "Error": "AdHocQuotaExceeded",
        "Cause": "Tenant ad hoc run quota limit of 5 runs per day exceeded."
      },
      "ResultPath": "$.error",
      "Next": "MarkRunFailed"
    },
    "CheckErrorBudgetLock": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:123456789012:function:tf2-finops-sandbox-state",
      "Parameters": {
        "operation": "check_error_budget",
        "run_id.$": "$.run_id",
        "correlation_id.$": "$.correlation_id",
        "account_id.$": "$.account_id",
        "cost_period.$": "$.cost_period",
        "execution_date.$": "$.execution_date",
        "tenant_id.$": "$.tenant_id",
        "force_dry_run.$": "$.force_dry_run"
      },
      "ResultPath": "$.error_budget_check",
      "Next": "EvaluateErrorBudgetLock",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkRunFailed"
        }
      ]
    },
    "EvaluateErrorBudgetLock": {
      "Type": "Pass",
      "Parameters": {
        "run_id.$": "$.run_id",
        "correlation_id.$": "$.correlation_id",
        "account_id.$": "$.account_id",
        "cost_period.$": "$.cost_period",
        "execution_date.$": "$.execution_date",
        "tenant_id.$": "$.tenant_id",
        "is_ad_hoc.$": "$.is_ad_hoc",
        "ai_contract_version.$": "$.ai_contract_version",
        "cur_retry.$": "$.cur_retry",
        "ai_retry.$": "$.ai_retry",
        "retry_after_seconds.$": "$.retry_after_seconds",
        "account_policy.$": "$.account_policy",
        "environment.$": "$.environment",
        "state.$": "$.state",
        "force_dry_run.$": "$.error_budget_check.force_dry_run",
        "error_budget_locked.$": "$.error_budget_check.locked"
      },
      "ResultPath": "$",
      "Next": "IngestCostData"
    },
    "IngestCostData": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:123456789012:function:tf2-finops-sandbox-cost_puller",
      "ResultPath": "$.ingestion",
      "Next": "IngestionReady",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkRunFailed"
        }
      ]
    },
    "IngestionReady": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.ingestion.status",
          "StringEquals": "CUR_DELAY",
          "Next": "IncrementCURRetry"
        },
        {
          "Variable": "$.ingestion.status",
          "StringEquals": "CE_THROTTLED",
          "Next": "IncrementCERetry"
        },
        {
          "Variable": "$.ingestion.status",
          "StringEquals": "READY",
          "Next": "NormalizeCostWindow"
        }
      ],
      "Default": "SetDefaultIngestionError"
    },
    "IncrementCURRetry": {
      "Type": "Pass",
      "Parameters": {
        "count.$": "States.MathAdd($.cur_retry.count, 1)",
        "max.$": "$.cur_retry.max"
      },
      "ResultPath": "$.cur_retry",
      "Next": "CURRetryExceeded"
    },
    "CURRetryExceeded": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.cur_retry.count",
          "NumericGreaterThanEquals": 4,
          "Next": "SetCURDelayExceededError"
        }
      ],
      "Default": "WaitForCURExport"
    },
    "IncrementCERetry": {
      "Type": "Pass",
      "Parameters": {
        "count.$": "States.MathAdd($.ce_retry.count, 1)",
        "max.$": "$.ce_retry.max"
      },
      "ResultPath": "$.ce_retry",
      "Next": "CERetryExceeded"
    },
    "CERetryExceeded": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.ce_retry.count",
          "NumericGreaterThanEquals": 3,
          "Next": "SetDefaultIngestionError"
        }
      ],
      "Default": "WaitForCostExplorer"
    },
    "SetCURDelayExceededError": {
      "Type": "Pass",
      "Result": {
        "Error": "CURDelayExceeded",
        "Cause": "Billing reports (CUR) export delayed beyond 4 hours."
      },
      "ResultPath": "$.error",
      "Next": "SendCURDelayAlert"
    },
    "SendCURDelayAlert": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:ap-southeast-1:123456789012:tf2-finops-sandbox-engineering-alerts",
        "Subject": "FinOps Watch CUR Export Delay Alert",
        "Message.$": "States.Format('CUR billing export delayed beyond 4 hours for Run ID: {}', $.run_id)"
      },
      "ResultPath": "$.cur_delay_alert_result",
      "Next": "WriteCURDelayAudit"
    },
    "WriteCURDelayAudit": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:123456789012:function:tf2-finops-sandbox-audit_writer",
      "Parameters": {
        "run_id.$": "$.run_id",
        "correlation_id.$": "$.correlation_id",
        "account_id.$": "$.account_id",
        "cost_period.$": "$.cost_period",
        "execution_date.$": "$.execution_date",
        "tenant_id.$": "$.tenant_id",
        "environment.$": "$.environment",
        "account_policy.$": "$.account_policy",
        "action": "fail-closed-cur-delay",
        "error.$": "$.error"
      },
      "ResultPath": "$.cur_delay_audit_result",
      "Next": "MarkRunFailed"
    },
    "SetDefaultIngestionError": {
      "Type": "Pass",
      "Result": {
        "Error": "IngestionFailed",
        "Cause": "Cost ingestion returned an unexpected state or failed."
      },
      "ResultPath": "$.error",
      "Next": "MarkRunFailed"
    },
    "WaitForCURExport": {
      "Type": "Wait",
      "Seconds": 3600,
      "Next": "IngestCostData"
    },
    "WaitForCostExplorer": {
      "Type": "Wait",
      "Seconds": 300,
      "Next": "IngestCostData"
    },
    "NormalizeCostWindow": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:123456789012:function:tf2-finops-sandbox-normalizer",
      "ResultPath": "$.normalized",
      "Next": "CheckTelemetryQuality",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkRunFailed"
        }
      ]
    },
    "CheckTelemetryQuality": {
      "Type": "Choice",
      "Choices": [
        {
          "Or": [
            {
              "Variable": "$.normalized.details.completeness_score",
              "NumericLessThan": 0.8
            },
            {
              "Variable": "$.normalized.details.delayed_cur",
              "BooleanEquals": true
            },
            {
              "Variable": "$.normalized.details.stale_cost_explorer",
              "BooleanEquals": true
            },
            {
              "Variable": "$.normalized.details.missing_cloudwatch",
              "BooleanEquals": true
            },
            {
              "Variable": "$.normalized.details.estimated_billing",
              "BooleanEquals": true
            }
          ],
          "Next": "SetTelemetryForceDryRun"
        }
      ],
      "Default": "VerifyS3Pointer"
    },
    "SetTelemetryForceDryRun": {
      "Type": "Pass",
      "Parameters": {
        "run_id.$": "$.run_id",
        "correlation_id.$": "$.correlation_id",
        "account_id.$": "$.account_id",
        "cost_period.$": "$.cost_period",
        "execution_date.$": "$.execution_date",
        "tenant_id.$": "$.tenant_id",
        "is_ad_hoc.$": "$.is_ad_hoc",
        "ai_contract_version.$": "$.ai_contract_version",
        "cur_retry.$": "$.cur_retry",
        "ai_retry.$": "$.ai_retry",
        "retry_after_seconds.$": "$.retry_after_seconds",
        "account_policy.$": "$.account_policy",
        "environment.$": "$.environment",
        "state.$": "$.state",
        "error_budget_locked.$": "$.error_budget_locked",
        "ingestion.$": "$.ingestion",
        "normalized.$": "$.normalized",
        "force_dry_run": true
      },
      "ResultPath": "$",
      "Next": "VerifyS3Pointer"
    },
    "VerifyS3Pointer": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.normalized.details.s3_bucket_uri",
              "IsPresent": true
            },
            {
              "Variable": "$.normalized.details.s3_bucket_uri",
              "StringMatches": "s3://*.json.gz"
            }
          ],
          "Next": "BuildDetectRequestS3Pointer"
        }
      ],
      "Default": "SetS3PointerMissingError"
    },
    "SetS3PointerMissingError": {
      "Type": "Pass",
      "Result": {
        "Error": "S3PointerMissing",
        "Cause": "No valid gzipped S3 pointer was produced for AI detection."
      },
      "ResultPath": "$.error",
      "Next": "FailClosed"
    },
    "BuildDetectRequestS3Pointer": {
      "Type": "Pass",
      "Parameters": {
        "path": "/v1/detect",
        "method": "POST",
        "tenant_id.$": "$.tenant_id",
        "correlation_id.$": "$.correlation_id",
        "idempotency_key.$": "States.Format('{}:{}:{}', $.tenant_id, $.execution_date, $.normalized.details.batch_type)",
        "ai_contract_version.$": "$.ai_contract_version",
        "dry_run_mode.$": "$.force_dry_run",
        "body": {
          "data_source_type": "S3_POINTER",
          "is_ad_hoc.$": "$.is_ad_hoc",
          "telemetry_delay_event.$": "$.normalized.details.telemetry_delay_event",
          "s3_bucket_uri.$": "$.normalized.details.s3_bucket_uri",
          "business_context.$": "$.normalized.details.business_context",
          "resource_utilization_metrics.$": "$.normalized.details.resource_utilization_metrics"
        }
      },
      "ResultPath": "$.ai_detect_request",
      "Next": "InvokeDetect"
    },
    "InvokeDetect": {
      "Type": "Task",
      "Comment": "Step Functions invokes VpcAlbCallerLambda; helper sends signed HTTPS to internal ALB; ALB invokes AI Engine Request Lambda live alias.",
      "Resource": "arn:aws:lambda:ap-southeast-1:123456789012:function:tf2-finops-sandbox-vpc_alb_caller",
      "Parameters": {
        "path.$": "$.ai_detect_request.path",
        "method.$": "$.ai_detect_request.method",
        "tenant_id.$": "$.ai_detect_request.tenant_id",
        "correlation_id.$": "$.ai_detect_request.correlation_id",
        "idempotency_key.$": "$.ai_detect_request.idempotency_key",
        "ai_contract_version.$": "$.ai_detect_request.ai_contract_version",
        "body.$": "$.ai_detect_request.body",
        "dry_run_mode.$": "$.ai_detect_request.dry_run_mode"
      },
      "ResultPath": "$.ai_detect_response",
      "Next": "EvaluateDetectResponse",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailClosed"
        }
      ]
    },
    "EvaluateDetectResponse": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.ai_detect_response.success",
          "BooleanEquals": false,
          "Next": "SetAIFailClosedError"
        },
        {
          "Variable": "$.ai_detect_response.data_confidence",
          "StringEquals": "LOW",
          "Next": "SetAIFailClosedError"
        },
        {
          "And": [
            {
              "Variable": "$.ai_detect_response.success",
              "BooleanEquals": true
            },
            {
              "Variable": "$.ai_detect_response.anomalies_detected",
              "BooleanEquals": true
            },
            {
              "Variable": "$.ai_detect_response.anomalies_list",
              "IsPresent": true
            }
          ],
          "Next": "InvokeDecide"
        }
      ],
      "Default": "MarkRunComplete"
    },
    "SetAIFailClosedError": {
      "Type": "Pass",
      "Result": {
        "Error": "AIEngineFailClosed",
        "Cause": "AI Engine returned an unsuccessful or low-confidence detection response."
      },
      "ResultPath": "$.error",
      "Next": "FailClosed"
    },
    "InvokeDecide": {
      "Type": "Task",
      "Comment": "Step Functions invokes VpcAlbCallerLambda; helper sends signed HTTPS to internal ALB; ALB invokes AI Engine Request Lambda live alias.",
      "Resource": "arn:aws:lambda:ap-southeast-1:123456789012:function:tf2-finops-sandbox-vpc_alb_caller",
      "Parameters": {
        "path": "/v1/decide",
        "method": "POST",
        "tenant_id.$": "$.tenant_id",
        "correlation_id.$": "$.correlation_id",
        "idempotency_key.$": "$.correlation_id",
        "ai_contract_version.$": "$.ai_contract_version",
        "body": {
          "correlation_id.$": "$.correlation_id",
          "idempotency_key.$": "$.correlation_id",
          "dry_run_mode.$": "$.force_dry_run",
          "anomaly_context.$": "$.ai_detect_response.anomalies_list[0]"
        }
      },
      "ResultPath": "$.ai_decide_response",
      "Next": "CacheRollbackPayload",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailClosed"
        }
      ]
    },
    "CacheRollbackPayload": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "tf2-finops-sandbox-rollback-cache",
        "Item": {
          "anomaly_id": {
            "S.$": "$.ai_detect_response.anomalies_list[0].anomaly_id"
          },
          "rollback_payload": {
            "S.$": "States.JsonToString($.ai_decide_response.rollback_payload)"
          }
        }
      },
      "ResultPath": "$.cache_rollback_result",
      "Next": "FormatDecideResult"
    },
    "FormatDecideResult": {
      "Type": "Pass",
      "Parameters": {
        "anomaly_found": true,
        "required_fields_valid": true,
        "recommended_containment_mode.$": "$.ai_decide_response.action_plan[0].action",
        "anomaly_id.$": "$.ai_detect_response.anomalies_list[0].anomaly_id",
        "severity.$": "$.ai_detect_response.anomalies_list[0].severity",
        "confidence_score.$": "$.ai_detect_response.anomalies_list[0].confidence_score"
      },
      "ResultPath": "$.ai",
      "Next": "RouteAlert"
    },
    "RouteAlert": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:123456789012:function:tf2-finops-sandbox-router",
      "ResultPath": "$.alert",
      "Next": "FinanceAlertRequired",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkRunFailed"
        }
      ]
    },
    "FinanceAlertRequired": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.alert.details.finance_route.deliver",
          "BooleanEquals": true,
          "Next": "SendFinanceAlert"
        }
      ],
      "Default": "EngineeringAlertRequired"
    },
    "SendFinanceAlert": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:ap-southeast-1:123456789012:tf2-finops-sandbox-finance-alerts",
        "Subject.$": "$.alert.details.finance_route.subject",
        "Message.$": "$.alert.details.finance_route.message"
      },
      "ResultPath": "$.finance_alert_result",
      "Next": "EngineeringAlertRequired",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.alert_error",
          "Next": "WriteAlertDeliveryFailureAudit"
        }
      ]
    },
    "EngineeringAlertRequired": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.alert.details.engineering_route.deliver",
          "BooleanEquals": true,
          "Next": "SendEngineeringAlert"
        }
      ],
      "Default": "EvaluateContainmentPolicy"
    },
    "SendEngineeringAlert": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:ap-southeast-1:123456789012:tf2-finops-sandbox-engineering-alerts",
        "Subject.$": "$.alert.details.engineering_route.subject",
        "Message.$": "$.alert.details.engineering_route.message"
      },
      "ResultPath": "$.engineering_alert_result",
      "Next": "EvaluateContainmentPolicy",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.alert_error",
          "Next": "WriteAlertDeliveryFailureAudit"
        }
      ]
    },
    "WriteAlertDeliveryFailureAudit": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:123456789012:function:tf2-finops-sandbox-audit_writer",
      "ResultPath": "$.alert_failure_audit",
      "Next": "MarkRunFailed",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkRunFailed"
        }
      ]
    },
    "EvaluateContainmentPolicy": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.account_policy.environment",
              "StringEquals": "prod"
            },
            {
              "Or": [
                {
                  "Variable": "$.ai.recommended_containment_mode",
                  "StringEquals": "terminate"
                },
                {
                  "Variable": "$.ai.recommended_containment_mode",
                  "StringEquals": "delete"
                },
                {
                  "Variable": "$.ai.recommended_containment_mode",
                  "StringEquals": "modify_iam"
                },
                {
                  "Variable": "$.ai.recommended_containment_mode",
                  "StringEquals": "apply"
                },
                {
                  "Variable": "$.ai.recommended_containment_mode",
                  "StringEquals": "auto-shutdown"
                },
                {
                  "Variable": "$.ai.recommended_containment_mode",
                  "StringEquals": "quota-cap"
                },
                {
                  "Variable": "$.ai.recommended_containment_mode",
                  "StringEquals": "time-gated-countdown"
                }
              ]
            }
          ],
          "Next": "WriteDeniedAudit"
        },
        {
          "And": [
            {
              "Variable": "$.force_dry_run",
              "BooleanEquals": true
            },
            {
              "Not": {
                "Or": [
                  {
                    "Variable": "$.ai.recommended_containment_mode",
                    "StringEquals": "dry-run"
                  },
                  {
                    "Variable": "$.ai.recommended_containment_mode",
                    "StringEquals": "tag"
                  },
                  {
                    "Variable": "$.ai.recommended_containment_mode",
                    "StringEquals": "suggest"
                  },
                  {
                    "Variable": "$.ai.recommended_containment_mode",
                    "StringEquals": "tag-for-review"
                  }
                ]
              }
            }
          ],
          "Next": "WriteDeniedAudit"
        },
        {
          "And": [
            {
              "Variable": "$.account_policy.environment",
              "StringEquals": "prod"
            },
            {
              "Or": [
                {
                  "Variable": "$.ai.recommended_containment_mode",
                  "StringEquals": "tag"
                },
                {
                  "Variable": "$.ai.recommended_containment_mode",
                  "StringEquals": "suggest"
                },
                {
                  "Variable": "$.ai.recommended_containment_mode",
                  "StringEquals": "dry-run"
                },
                {
                  "Variable": "$.ai.recommended_containment_mode",
                  "StringEquals": "tag-for-review"
                }
              ]
            }
          ],
          "Next": "WritePreActionAudit"
        },
        {
          "And": [
            {
              "Variable": "$.account_policy.environment",
              "StringEquals": "sandbox"
            },
            {
              "Variable": "$.approval_status",
              "IsPresent": true
            },
            {
              "Variable": "$.approval_status",
              "StringEquals": "approved"
            }
          ],
          "Next": "WritePreActionAudit"
        },
        {
          "And": [
            {
              "Variable": "$.account_policy.environment",
              "StringEquals": "sandbox"
            },
            {
              "Or": [
                {
                  "Variable": "$.ai.recommended_containment_mode",
                  "StringEquals": "tag"
                },
                {
                  "Variable": "$.ai.recommended_containment_mode",
                  "StringEquals": "suggest"
                },
                {
                  "Variable": "$.ai.recommended_containment_mode",
                  "StringEquals": "dry-run"
                },
                {
                  "Variable": "$.ai.recommended_containment_mode",
                  "StringEquals": "tag-for-review"
                }
              ]
            }
          ],
          "Next": "WritePreActionAudit"
        }
      ],
      "Default": "WritePendingApprovalAudit"
    },
    "WritePreActionAudit": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:123456789012:function:tf2-finops-sandbox-audit_writer",
      "ResultPath": "$.pre_audit",
      "Next": "ExecuteContainment",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkRunFailed"
        }
      ]
    },
    "ExecuteContainment": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:123456789012:function:tf2-finops-sandbox-containment_worker",
      "ResultPath": "$.containment",
      "Next": "ReportVerifyResult",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
