{
  "Comment": "TF2 FinOps Watch CDO daily workflow",
  "StartAt": "InitializeRunContext",
  "States": {
    "InitializeRunContext": {
      "Type": "Pass",
      "Result": {
        "count": 0,
        "max": 12
      },
      "ResultPath": "$.cur_retry",
      "Next": "LoadAccountPolicy"
    },
    "LoadAccountPolicy": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:getItem",
      "Parameters": {
        "TableName": "tf2-finops-account-policy",
        "Key": {
          "account_id": {
            "S.$": "$.account_id"
          }
        }
      },
      "ResultSelector": {
        "account_id.$": "$.Item.account_id.S",
        "environment.$": "$.Item.environment.S"
      },
      "ResultPath": "$.account_policy",
      "Next": "OverwriteEnvironment",
      "Retry": [
        {
          "ErrorEquals": [
            "DynamoDb.SdkClientException",
            "DynamoDb.AmazonDynamoDBException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkRunFailed"
        }
      ]
    },
    "OverwriteEnvironment": {
      "Type": "Pass",
      "InputPath": "$.account_policy.environment",
      "ResultPath": "$.environment",
      "Next": "CheckRunState"
    },
    "CheckRunState": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID:function:tf2-finops-state",
      "ResultPath": "$.state",
      "Next": "DuplicateRun",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkRunFailed"
        }
      ]
    },
    "DuplicateRun": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.state.status",
          "StringEquals": "COMPLETED",
          "Next": "DuplicateIgnored"
        },
        {
          "Variable": "$.state.status",
          "StringEquals": "IN_PROGRESS",
          "Next": "DuplicateIgnored"
        }
      ],
      "Default": "IngestCostData"
    },
    "IngestCostData": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID:function:tf2-finops-cost-puller",
      "ResultPath": "$.ingestion",
      "Next": "IngestionReady",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkRunFailed"
        }
      ]
    },
    "IngestionReady": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.ingestion.status",
          "StringEquals": "CUR_DELAY",
          "Next": "IncrementCURRetry"
        },
        {
          "Variable": "$.ingestion.status",
          "StringEquals": "CE_THROTTLED",
          "Next": "WaitForCostExplorer"
        },
        {
          "Variable": "$.ingestion.status",
          "StringEquals": "READY",
          "Next": "NormalizeCostWindow"
        }
      ],
      "Default": "SetDefaultIngestionError"
    },
    "IncrementCURRetry": {
      "Type": "Pass",
      "Parameters": {
        "count.$": "States.MathAdd($.cur_retry.count, 1)",
        "max.$": "$.cur_retry.max"
      },
      "ResultPath": "$.cur_retry",
      "Next": "CURRetryExceeded"
    },
    "CURRetryExceeded": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.cur_retry.count",
          "NumericGreaterThanEquals": 12,
          "Next": "SetCURDelayExceededError"
        }
      ],
      "Default": "WaitForCURExport"
    },
    "SetCURDelayExceededError": {
      "Type": "Pass",
      "Result": {
        "Error": "CURDelayExceeded",
        "Cause": "Billing reports (CUR) export delayed beyond 24 hours."
      },
      "ResultPath": "$.error",
      "Next": "MarkRunFailed"
    },
    "SetDefaultIngestionError": {
      "Type": "Pass",
      "Result": {
        "Error": "IngestionFailed",
        "Cause": "Cost ingestion returned an unexpected state or failed."
      },
      "ResultPath": "$.error",
      "Next": "MarkRunFailed"
    },
    "WaitForCURExport": {
      "Type": "Wait",
      "Seconds": 7200,
      "Next": "IngestCostData"
    },
    "WaitForCostExplorer": {
      "Type": "Wait",
      "Seconds": 300,
      "Next": "IngestCostData"
    },
    "NormalizeCostWindow": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID:function:tf2-finops-normalizer",
      "ResultPath": "$.normalized",
      "Next": "CallAIContract",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkRunFailed"
        }
      ]
    },
    "CallAIContract": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID:function:tf2-finops-ai-client",
      "ResultPath": "$.ai",
      "Next": "AIResponseValid",
      "TimeoutSeconds": 60,
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "FailClosed"
        }
      ]
    },
    "AIResponseValid": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.ai.status",
          "StringEquals": "UNAVAILABLE",
          "Next": "FailClosed"
        },
        {
          "Variable": "$.ai.status",
          "StringEquals": "TIMEOUT",
          "Next": "FailClosed"
        },
        {
          "Variable": "$.ai.status",
          "StringEquals": "CONTRACT_MISMATCH",
          "Next": "FailClosed"
        },
        {
          "Variable": "$.ai.required_fields_valid",
          "BooleanEquals": false,
          "Next": "FailClosed"
        }
      ],
      "Default": "AnomalyFound"
    },
    "AnomalyFound": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.ai.anomaly_found",
          "BooleanEquals": true,
          "Next": "RouteAlert"
        }
      ],
      "Default": "MarkRunComplete"
    },
    "RouteAlert": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID:function:tf2-finops-router",
      "ResultPath": "$.alert",
      "Next": "FinanceAlertRequired",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkRunFailed"
        }
      ]
    },
    "FinanceAlertRequired": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.alert.details.finance_route.deliver",
          "BooleanEquals": true,
          "Next": "SendFinanceAlert"
        }
      ],
      "Default": "EngineeringAlertRequired"
    },
    "SendFinanceAlert": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:ap-southeast-1:ACCOUNT_ID:tf2-finops-finance-alerts",
        "Subject.$": "$.alert.details.finance_route.subject",
        "Message.$": "$.alert.details.finance_route.message"
      },
      "ResultPath": "$.finance_alert_result",
      "Next": "EngineeringAlertRequired",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.alert_error",
          "Next": "WriteAlertDeliveryFailureAudit"
        }
      ]
    },
    "EngineeringAlertRequired": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.alert.details.engineering_route.deliver",
          "BooleanEquals": true,
          "Next": "SendEngineeringAlert"
        }
      ],
      "Default": "EvaluateContainmentPolicy"
    },
    "SendEngineeringAlert": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:ap-southeast-1:ACCOUNT_ID:tf2-finops-engineering-alerts",
        "Subject.$": "$.alert.details.engineering_route.subject",
        "Message.$": "$.alert.details.engineering_route.message"
      },
      "ResultPath": "$.engineering_alert_result",
      "Next": "EvaluateContainmentPolicy",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.alert_error",
          "Next": "WriteAlertDeliveryFailureAudit"
        }
      ]
    },
    "WriteAlertDeliveryFailureAudit": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID:function:tf2-finops-audit-writer",
      "ResultPath": "$.alert_failure_audit",
      "Next": "MarkRunFailed",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkRunFailed"
        }
      ]
    },
    "EvaluateContainmentPolicy": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.account_policy.environment",
              "StringEquals": "prod"
            },
            {
              "Or": [
                {
                  "Variable": "$.ai.recommended_containment_mode",
                  "StringEquals": "terminate"
                },
                {
                  "Variable": "$.ai.recommended_containment_mode",
                  "StringEquals": "delete"
                },
                {
                  "Variable": "$.ai.recommended_containment_mode",
                  "StringEquals": "modify_iam"
                },
                {
                  "Variable": "$.ai.recommended_containment_mode",
                  "StringEquals": "apply"
                }
              ]
            }
          ],
          "Next": "WriteDeniedAudit"
        },
        {
          "And": [
            {
              "Variable": "$.account_policy.environment",
              "StringEquals": "prod"
            },
            {
              "Or": [
                {
                  "Variable": "$.ai.recommended_containment_mode",
                  "StringEquals": "tag"
                },
                {
                  "Variable": "$.ai.recommended_containment_mode",
                  "StringEquals": "suggest"
                },
                {
                  "Variable": "$.ai.recommended_containment_mode",
                  "StringEquals": "dry-run"
                }
              ]
            }
          ],
          "Next": "WritePreActionAudit"
        },
        {
          "And": [
            {
              "Variable": "$.account_policy.environment",
              "StringEquals": "sandbox"
            },
            {
              "Variable": "$.approval_status",
              "IsPresent": true
            },
            {
              "Variable": "$.approval_status",
              "StringEquals": "approved"
            }
          ],
          "Next": "WritePreActionAudit"
        }
      ],
      "Default": "WritePendingApprovalAudit"
    },
    "WritePreActionAudit": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID:function:tf2-finops-audit-writer",
      "ResultPath": "$.pre_audit",
      "Next": "ExecuteContainment",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkRunFailed"
        }
      ]
    },
    "ExecuteContainment": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID:function:tf2-finops-containment-worker",
      "ResultPath": "$.containment",
      "Next": "WritePostActionAudit",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.containment_error",
          "Next": "WriteContainmentFailureAudit"
        }
      ]
    },
    "WritePostActionAudit": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID:function:tf2-finops-audit-writer",
      "ResultPath": "$.post_audit",
      "Next": "MarkRunComplete",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkRunFailed"
        }
      ]
    },
    "WriteDeniedAudit": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID:function:tf2-finops-audit-writer",
      "ResultPath": "$.denied_audit",
      "Next": "MarkRunComplete",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkRunFailed"
        }
      ]
    },
    "WritePendingApprovalAudit": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID:function:tf2-finops-audit-writer",
      "ResultPath": "$.pending_audit",
      "Next": "MarkRunComplete",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkRunFailed"
        }
      ]
    },
    "FailClosed": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID:function:tf2-finops-audit-writer",
      "ResultPath": "$.failure_audit",
      "Next": "MarkRunFailed",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkRunFailed"
        }
      ]
    },
    "WriteContainmentFailureAudit": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID:function:tf2-finops-audit-writer",
      "ResultPath": "$.containment_failure_audit",
      "Next": "MarkRunFailed",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkRunFailed"
        }
      ]
    },
    "MarkRunComplete": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID:function:tf2-finops-state",
      "ResultPath": "$.completion",
      "Next": "RunCompleted",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkRunFailed"
        }
      ]
    },
    "MarkRunFailed": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:ACCOUNT_ID:function:tf2-finops-state",
      "ResultPath": "$.completion",
      "Next": "RunFailed",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure_error",
          "Next": "RunFailed"
        }
      ]
    },
    "RunCompleted": {
      "Type": "Succeed"
    },
    "DuplicateIgnored": {
      "Type": "Succeed"
    },
    "RunFailed": {
      "Type": "Fail",
      "Error": "FinOpsWorkflowFailed",
      "Cause": "Workflow failed or failed closed."
    }
  }
}