      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:ap-southeast-1:123456789012:tf2-finops-sandbox-engineering-alerts",
        "Subject": "FinOps Watch Fail-Closed Alert",
        "Message.$": "States.Format('CDO daily workflow failed closed. Run ID: {}, Error: {}, Cause: {}', $.run_id, $.error.Error, $.error.Cause)"
      },
      "ResultPath": "$.fail_closed_alert_result",
      "Next": "MarkRunFailed"
    },
    "WriteContainmentFailureAudit": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:123456789012:function:tf2-finops-sandbox-audit_writer",
      "ResultPath": "$.containment_failure_audit",
      "Next": "MarkRunFailed",
      "Retry": [
