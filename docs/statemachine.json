      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.error",
          "Next": "MarkRunFailed"
        }
      ]
    },
    "MarkRunFailed": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:ap-southeast-1:123456789012:function:tf2-finops-sandbox-state",
      "Parameters": {
        "operation": "failed",
        "run_id.$": "$.run_id",
        "correlation_id.$": "$.correlation_id",
        "account_id.$": "$.account_id",
        "cost_period.$": "$.cost_period",
        "execution_date.$": "$.execution_date"
      },
      "ResultPath": "$.completion",
      "Next": "RunFailed",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.failure_error",
          "Next": "RunFailed"
        }
      ]
    },
    "RunCompleted": {
      "Type": "Succeed"
    },
    "DuplicateIgnored": {
      "Type": "Succeed"
    },
    "RunFailed": {
      "Type": "Fail",
      "Error": "FinOpsWorkflowFailed",
      "Cause": "Workflow failed or failed closed."
    }
  }
}
